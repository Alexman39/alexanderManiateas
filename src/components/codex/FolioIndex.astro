---
import Sketch from '../Sketch.astro';
import { domains, statuses, type Domain } from '../../data/codex';
import { url, useT, type Lang } from '../../i18n';
import type { Project } from '../../i18n/content';

interface Props {
  lang: Lang;
  projects: Project[];
}

const { lang, projects } = Astro.props;
const t = useT(lang);
const order = Object.keys(domains) as Domain[];
const groups = order
  .map((d) => ({ key: d, ...domains[d], items: projects.filter((p) => p.data.domain === d) }))
  .filter((g) => g.items.length);
---

<div class="folio-index">
  {
    groups.map((g) => (
      <section class="group" aria-labelledby={`group-${g.key}`}>
        <header class="group-head">
          <h2 id={`group-${g.key}`}>{g.name}</h2>
          <p>
            <span class="label">{g.gloss[lang]}</span> {g.blurb[lang]}
          </p>
        </header>
        <ul class="cards">
          {g.items.map((p) => {
            const unfinished = p.data.status === 'non-finito';
            return (
              <li>
                <a class="card" href={url(`projects/${p.id}`, lang)} data-card={p.id}>
                  <div class="card-art" transition:name={`sketch-${p.id}`}>
                    <Sketch name={p.data.sketch} state={unfinished ? 'unfinished' : 'ink'} />
                  </div>
                  <span class="label">
                    f. {p.data.folio} · {statuses[p.data.status][lang]}
                    {p.data.capolavoro && <> · capolavoro</>}
                  </span>
                  <h3>{p.data.title}</h3>
                  <span class="italian">{p.data.motto}</span>
                  <p>{p.data.summary}</p>
                  <span class="card-foot">
                    <span class="label">{p.data.stack.join(' · ')}</span>
                    <span class="studied label" data-studied-badge hidden>
                      {t('index.studied')}
                    </span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</div>

<script>
  import { load } from '../../scripts/codex';
  const mark = () => {
    const { visited } = load();
    document.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
      card.querySelector<HTMLElement>('[data-studied-badge]')!.hidden = !visited.includes(card.dataset.card!);
    });
  };
  document.addEventListener('astro:page-load', mark);
  document.addEventListener('codex:change', mark);
</script>

<style>
  .folio-index {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(48px, 7vw, 88px);
  }
  .group-head {
    display: flex;
    align-items: baseline;
    gap: 8px 24px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .group-head h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
  }
  .group-head p {
    color: var(--ink-2);
  }
  .group-head .label {
    color: var(--sanguine);
    margin-right: 8px;
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 20px;
  }
  .card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 22px 22px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    text-decoration: none;
    transition: transform 0.5s var(--ease), border-color 0.3s, box-shadow 0.5s var(--ease);
  }
  .card:hover {
    color: inherit;
    transform: translateY(-4px) rotate(-0.4deg);
    border-color: var(--paper-edge);
    box-shadow: var(--shadow);
  }
  .card-art {
    width: 62%;
    aspect-ratio: 1;
    margin: 0 auto 10px;
  }
  .card-art :global(.sketch) {
    width: 100%;
    height: 100%;
  }
  .card h3 {
    font-size: 1.75rem;
  }
  .card p {
    color: var(--ink-2);
    font-size: 0.95rem;
    margin-top: 6px;
  }
  .card-foot {
    margin-top: auto;
    padding-top: 14px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .studied {
    color: var(--seal);
  }

  /* Phones: each domain becomes a swipeable row of folios. */
  @media (max-width: 760px) {
    .cards {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      margin-inline: calc(-1 * var(--gutter));
      padding: 4px var(--gutter) 16px;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .cards li {
      scroll-snap-align: start;
    }
  }
</style>
