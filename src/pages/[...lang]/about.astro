---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import portrait from '../../assets/photos/profile.jpg';
import { experience, languages, site, skills, socials } from '../../data/site';
import { langFromParam, langParams, url, useT, type Lang } from '../../i18n';

export const getStaticPaths = langParams;

const lang = langFromParam(Astro.params.lang);
const t = useT(lang);

const bio: Record<Lang, string[]> = {
  en: [
    "I'm Alexander, a software developer in Athens. I'm studying for a BSc in Computer Science at Metropolitan College, after four years of Business Administration at the University of the Aegean in Chios. That detour taught me to think about the people and businesses behind the software.",
    "I've freelanced since 2020, building custom, mobile-first websites for small businesses: talking to the client, shaping what they need, then designing and building it. Three years in customer support at Teleperformance taught me patience, and how to explain complex things simply.",
    "Today I'm Digital Systems Partner at FlexPro Coaching, co-developing an online coaching platform, which sits neatly where my two passions meet. Outside of code, I train seriously and I'm learning Russian.",
    "I admire Leonardo da Vinci more than anyone: his curiosity, his discipline, his refusal to stay in one lane. This site borrows his notebooks as its form. It's a reminder to keep studying.",
  ],
  el: [
    'Είμαι ο Αλέξανδρος, προγραμματιστής στην Αθήνα. Σπουδάζω για BSc στην Πληροφορική στο Metropolitan College, μετά από τέσσερα χρόνια σπουδών στη Διοίκηση Επιχειρήσεων στο Πανεπιστήμιο Αιγαίου, στη Χίο. Αυτή η παράκαμψη μου έμαθε να σκέφτομαι τους ανθρώπους και τις επιχειρήσεις πίσω από το λογισμικό.',
    'Από το 2020 δουλεύω ως freelancer, φτιάχνοντας ιστοσελίδες κατά παραγγελία, mobile-first, για μικρές επιχειρήσεις: μιλάω με τον πελάτη, διαμορφώνουμε μαζί τι χρειάζεται, και μετά το σχεδιάζω και το υλοποιώ. Τρία χρόνια στην εξυπηρέτηση πελατών στην Teleperformance μού έμαθαν υπομονή, και πώς να εξηγώ απλά τα σύνθετα πράγματα.',
    'Σήμερα είμαι Digital Systems Partner στο FlexPro Coaching, όπου συν-αναπτύσσω μια πλατφόρμα online coaching, ακριβώς εκεί όπου συναντιούνται τα δύο μου πάθη. Έξω από τον κώδικα, προπονούμαι σοβαρά και μαθαίνω ρωσικά.',
    'Θαυμάζω τον Λεονάρντο ντα Βίντσι περισσότερο από οποιονδήποτε: την περιέργειά του, την πειθαρχία του, την άρνησή του να μείνει σε ένα μόνο πεδίο. Αυτός ο ιστότοπος δανείζεται τη μορφή των σημειωματαρίων του. Είναι μια υπενθύμιση να συνεχίζω να μελετώ.',
  ],
};
---

<Base lang={lang} title={t('about.title')} description={t('about.description')}>
  <div class="page about">
    <section class="intro">
      <div class="intro-text">
        <p class="label">{t('about.eyebrow')}</p>
        <h1>{t('about.h1')}</h1>
        <div class="prose">
          {bio[lang].map((para) => <p>{para}</p>)}
        </div>
      </div>
      <figure class="portrait">
        <Image src={portrait} alt={t('site.name')} widths={[400, 800]} sizes="(max-width: 900px) 80vw, 400px" />
        <figcaption class="label">{t('about.caption')}</figcaption>
      </figure>
    </section>

    <hr class="rule" />

    <section class="grid">
      <div>
        <h2>{t('about.timeline')}</h2>
        <ol class="timeline">
          {
            experience[lang].map((e) => (
              <li>
                <span class="label when">{e.when}</span>
                <h3>{e.title}</h3>
                <p class="where">{e.where}</p>
                <p class="note">{e.note}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="side">
        <section>
          <h2>{t('about.craft')}</h2>
          <ul class="skills">
            {
              skills[lang].map((s, i) => (
                <li>
                  <span class="letter">{'ABCDEF'[i]}</span>
                  <span>
                    <strong>{s.name}</strong>
                    <small>{s.note}</small>
                  </span>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2>{t('about.languages')}</h2>
          <dl class="langs">
            {
              languages[lang].map((l) => (
                <div>
                  <dt>{l.name}</dt>
                  <dd class="label">{l.level}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="contact">
          <h2>{t('about.write')}</h2>
          <p>{t('about.writeText')}</p>
          <a class="button primary" href={`mailto:${site.email}`}>{site.email}</a>
          {
            socials.length > 0 && (
              <p class="social-links">
                {socials.map((s) => (
                  <a href={s.href} rel="me noopener" target="_blank">
                    {s.label} ↗
                  </a>
                ))}
              </p>
            )
          }
          <a class="label see-codex" href={url('projects', lang)}>{t('about.codex')}</a>
        </section>
      </div>
    </section>
  </div>
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .intro-text {
    display: grid;
    gap: 28px;
  }
  .intro h1 {
    font-size: clamp(2.3rem, 4.6vw, 3.8rem);
  }
  .portrait {
    margin: 0;
    position: sticky;
    top: calc(var(--header-h) + 32px);
    display: grid;
    gap: 10px;
  }
  .portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 25%;
    border-radius: 200px 200px 12px 12px;
    filter: sepia(0.55) saturate(0.8) contrast(1.03);
    box-shadow: 0 0 0 1px var(--paper-edge), 0 0 0 10px var(--paper), 0 0 0 11px var(--paper-edge), var(--shadow);
    transition: filter 1.2s var(--ease);
  }
  .portrait:hover img {
    filter: none;
  }
  .portrait figcaption {
    text-align: center;
    margin-top: 10px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(32px, 6vw, 96px);
  }
  h2 {
    font-size: 2.2rem;
    margin-bottom: 20px;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 28px;
    border-left: 1px dashed var(--sanguine);
    display: grid;
    gap: 32px;
  }
  .timeline li {
    position: relative;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -34px;
    top: 6px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1.5px solid var(--sanguine);
    background: var(--paper);
  }
  .timeline h3 {
    font-size: 1.6rem;
    margin-top: 4px;
  }
  .where {
    font-weight: 600;
    margin-top: 2px;
  }
  .note {
    color: var(--ink-2);
    margin-top: 6px;
  }

  .side {
    display: grid;
    gap: 48px;
    align-content: start;
  }
  .skills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .skills li {
    display: flex;
    gap: 14px;
    align-items: start;
  }
  .skills strong {
    display: block;
  }
  .skills small {
    color: var(--ink-2);
    font-size: 0.9rem;
  }
  .letter {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--sanguine);
    color: var(--sanguine);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
  }

  .langs {
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .langs div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
  .langs dt {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
  }
  .langs dd {
    margin: 0;
  }

  .contact {
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .contact p {
    color: var(--ink-2);
  }
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .see-codex {
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .intro,
    .grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      position: static;
      order: -1;
      max-width: 340px;
    }
  }
</style>
