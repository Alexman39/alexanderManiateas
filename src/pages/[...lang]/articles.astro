---
import Base from '../../layouts/Base.astro';
import { formatDate, langFromParam, langParams, url, useT } from '../../i18n';
import { getArticles } from '../../i18n/content';

export const getStaticPaths = langParams;

const lang = langFromParam(Astro.params.lang);
const t = useT(lang);
const articles = await getArticles(lang);
---

<Base lang={lang} title={t('articles.title')} description={t('articles.description')}>
  <div class="page">
    <header class="head">
      <p class="label">{t('articles.eyebrow')}</p>
      <h1>{t('articles.h1')}</h1>
      <p class="lead">{t('articles.lead')}</p>
    </header>

    <ol class="entries">
      {
        articles.map((a, i) => (
          <li>
            <a href={url(`articles/${a.id}`, lang)} lang={a.translated ? undefined : 'en'}>
              <span class="num" aria-hidden="true">{String(articles.length - i).padStart(2, '0')}</span>
              <time class="label" datetime={a.data.date.toISOString()}>
                {formatDate(a.data.date, lang)}
              </time>
              <h2>{a.data.title}</h2>
              <p>{a.data.summary}</p>
              <span class="label read">{t('articles.read')}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .head {
    display: grid;
    gap: 18px;
    max-width: 900px;
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .head h1 {
    font-size: clamp(2.4rem, 5vw, 4.2rem);
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .entries a {
    position: relative;
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 8px 32px;
    padding: 36px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .num {
    grid-row: span 4;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 3rem;
    line-height: 1;
    color: var(--sanguine);
    opacity: 0.7;
  }
  .entries h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    transition: color 0.2s;
  }
  .entries a:hover h2 {
    color: var(--sanguine);
  }
  .entries p {
    color: var(--ink-2);
    max-width: 70ch;
  }
  .read {
    margin-top: 6px;
    color: var(--sanguine);
  }
  @media (max-width: 640px) {
    .entries a {
      grid-template-columns: 1fr;
    }
    .num {
      grid-row: auto;
      font-size: 2rem;
    }
  }
</style>
