---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { roman } from '../../data/text';
import { useT, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  plates: { src: ImageMetadata; caption: string; phone: boolean }[];
}

const { lang, plates } = Astro.props;
const t = useT(lang);

// Three columns with a large first plate fill neatly at 3, 5 or 6 plates; 2 and 4 sit better in two even columns.
const n = plates.length;
const featured = n === 3 || n >= 5;

const numbered = plates.map((p, i) => ({ p, i }));
type Cell = { kind: 'featured' | 'side' | 'single'; items: typeof numbered };
const cells: Cell[] = featured
  ? [
      { kind: 'featured', items: numbered.slice(0, 1) },
      { kind: 'side', items: numbered.slice(1, 3) },
      ...numbered.slice(3).map((x) => ({ kind: 'single' as const, items: [x] })),
    ]
  : numbered.map((x) => ({ kind: 'single' as const, items: [x] }));
const sizes = {
  featured: '(max-width: 900px) 100vw, 820px',
  side: '(max-width: 900px) 100vw, 400px',
  single: featured ? '(max-width: 900px) 100vw, 400px' : n === 1 ? '(max-width: 960px) 100vw, 920px' : '(max-width: 560px) 100vw, 610px',
};

// A larger copy of each plate for the lightbox.
const full = await Promise.all(plates.map((p) => getImage({ src: p.src, width: Math.min(1800, p.src.width), format: 'webp' })));
---

<section class="folio-section plates" aria-labelledby="plates-title" data-plates>
  <header class="folio-section-head">
    <h2 id="plates-title">{t('folio.plates')}</h2>
    <p class="label">{t('folio.platesSub')}</p>
  </header>

  <ul class:list={['grid', { pairs: !featured && n > 1, solo: n === 1 }]}>
    {
      cells.map((cell) => (
        <li class:list={['cell', cell.kind]}>
          {cell.items.map(({ p, i }) => (
            <figure class:list={['plate', { phone: p.phone }]}>
              <button
                type="button"
                class="frame"
                style={cell.kind === 'featured' ? `aspect-ratio:${p.src.width}/${p.src.height}` : undefined}
                data-plate={i}
                data-full={full[i].src}
                data-caption={`Tav. ${roman(i + 1)} · ${p.caption}`}
                aria-label={t('folio.enlarge', { n: roman(i + 1), caption: p.caption })}
              >
                <Image src={p.src} alt="" widths={cell.kind === 'featured' ? [640, 1100, 1600] : [420, 800, 1100]} sizes={sizes[cell.kind]} />
              </button>
              <figcaption>
                <span class="tav">Tav. {roman(i + 1)}</span> {p.caption}
              </figcaption>
            </figure>
          ))}
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" data-lightbox aria-label={t('folio.plates')}>
    <form method="dialog">
      <button class="close" aria-label={t('folio.closePlate')}>×</button>
    </form>
    <img data-lightbox-img alt="" />
    <p class="lightbox-caption" data-lightbox-caption></p>
  </dialog>
</section>

<script>
  let teardown: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    teardown?.();
    teardown = null;
    const root = document.querySelector<HTMLElement>('[data-plates]');
    if (!root) return;
    const ac = new AbortController();
    const frames = [...root.querySelectorAll<HTMLButtonElement>('[data-plate]')];
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + frames.length) % frames.length;
      const f = frames[current];
      img.src = f.dataset.full!;
      img.alt = f.dataset.caption!;
      caption.textContent = f.dataset.caption!;
    };

    frames.forEach((f, i) =>
      f.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      }, { signal: ac.signal }),
    );
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    }, { signal: ac.signal });
    // Click outside the picture closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    }, { signal: ac.signal });
    dialog.addEventListener('close', () => frames[current].focus(), { signal: ac.signal });

    teardown = () => ac.abort();
  });
</script>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }
  .grid.pairs {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .grid.solo {
    grid-template-columns: minmax(0, 920px);
    justify-content: center;
  }
  .cell.featured {
    grid-column: span 2;
  }
  /* The two plates beside the large one share its height. */
  .cell.side {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .plate {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .side .plate {
    flex: 1;
    min-height: 0;
  }

  /* A paper mat around each screenshot, like a plate tipped into a notebook. */
  .frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 1px solid var(--paper-edge);
    border-radius: 6px;
    background: var(--paper);
    box-shadow: var(--shadow);
    cursor: zoom-in;
    overflow: hidden;
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  .frame:hover {
    transform: translateY(-3px) rotate(-0.3deg);
  }
  .side .frame {
    flex: 1;
    aspect-ratio: auto;
    min-height: 140px;
  }
  .frame :global(img) {
    position: absolute;
    inset: 10px;
    width: calc(100% - 20px);
    height: calc(100% - 20px);
    object-fit: cover;
    object-position: top center;
    border-radius: 2px;
    box-shadow: 0 0 0 1px var(--line);
  }
  .phone .frame :global(img) {
    object-fit: contain;
    object-position: center;
    box-shadow: none;
    filter: drop-shadow(0 0 1px var(--ink-3));
  }

  figcaption {
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  .tav {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--sanguine);
    margin-right: 4px;
  }

  .lightbox {
    width: min(1400px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    padding: 18px 18px 14px;
    border: 1px solid var(--paper-edge);
    border-radius: 12px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow);
  }
  .lightbox::backdrop {
    background: rgb(25 16 8 / 0.7);
    backdrop-filter: blur(3px);
  }
  .lightbox img {
    display: block;
    width: 100%;
    max-height: calc(100dvh - 140px);
    object-fit: contain;
  }
  .lightbox-caption {
    margin-top: 10px;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
  }
  .close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 1;
    width: 40px;
    height: 40px;
    border: 1px solid var(--paper-edge);
    border-radius: 50%;
    background: var(--paper);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .grid,
    .grid.pairs {
      grid-template-columns: 1fr;
    }
    .cell.featured {
      grid-column: auto;
    }
    .cell.side {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .side .frame {
      flex: none;
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 560px) {
    .cell.side {
      grid-template-columns: 1fr;
    }
  }
</style>
