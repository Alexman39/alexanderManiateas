---
import Base from '../../layouts/Base.astro';
import Desk from '../../components/codex/Desk.astro';
import FolioIndex from '../../components/codex/FolioIndex.astro';
import { langFromParam, langParams, useT } from '../../i18n';
import { getProjects } from '../../i18n/content';

export const getStaticPaths = langParams;

const lang = langFromParam(Astro.params.lang);
const t = useT(lang);
const projects = await getProjects(lang);
const finished = projects.filter((p) => p.data.status !== 'non-finito').length;
const vars = { finished, wip: projects.length - finished };
---

<Base lang={lang} title={t('codex.title')} description={t('codex.description')}>
  <div class="codex-page" data-codex data-view="index">
    <header class="intro">
      <div>
        <p class="label">{t('codex.eyebrow')}</p>
        <h1 set:html={t('codex.h1')} />
      </div>
      <div class="intro-side">
        <p set:html={t('codex.intro', vars)} />
        <div class="view-switch" role="group" aria-label={t('codex.view')}>
          <button type="button" data-view-button="desk" aria-pressed="false">{t('codex.desk')}</button>
          <button type="button" data-view-button="index" aria-pressed="true">{t('codex.index')}</button>
        </div>
      </div>
    </header>

    <div class="view view-desk">
      <Desk lang={lang} projects={projects} />
    </div>
    <div class="view view-index">
      <FolioIndex lang={lang} projects={projects} />
    </div>
  </div>
</Base>

<script>
  import '../../scripts/desk';
</script>

<style>
  .codex-page {
    width: min(1480px, 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding-top: calc(var(--header-h) + 28px);
    padding-bottom: 96px;
  }

  .intro {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 16px 56px;
    align-items: end;
    margin-bottom: 22px;
  }
  .intro h1 {
    font-size: clamp(2rem, 3.4vw, 3rem);
    margin-top: 8px;
  }
  .intro h1 :global(em) {
    color: var(--sanguine);
    font-weight: 500;
  }
  .intro-side {
    display: grid;
    gap: 14px;
    justify-items: start;
    color: var(--ink-2);
    font-size: 0.98rem;
  }

  .view-switch {
    display: inline-flex;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .view-switch button {
    padding: 7px 18px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    color: var(--ink-2);
  }
  .view-switch button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  /* Without script only the index exists; the switch appears once the desk is ready. */
  .codex-page:not(.js-ready) .view-switch,
  .codex-page:not(.js-ready) .view-desk {
    display: none;
  }
  .codex-page[data-view='desk'] .view-index,
  .codex-page[data-view='index'] .view-desk {
    display: none;
  }

  @media (max-width: 900px) {
    .intro {
      grid-template-columns: 1fr;
    }
  }
</style>
