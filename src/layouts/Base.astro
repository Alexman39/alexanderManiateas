---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langNames, langs, splitPath, url, useT, type Lang } from '../i18n';
import { getProjects } from '../i18n/content';
import type { CodexMeta } from '../data/codex';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useT(lang);
const name = t('site.name');
const fullTitle = title ? `${title} · ${name}` : `${name} · ${t('site.role')}`;
const desc = description ?? t('site.description');

// The same page in every language, for the switch and for search engines.
const { rest } = splitPath(Astro.url.pathname);
const alternates = langs.map((l) => ({ lang: l, href: new URL(url(rest, l), Astro.site).href }));
const canonical = alternates.find((a) => a.lang === lang)!.href;
const other = langs.find((l) => l !== lang)!;

const meta: CodexMeta = (await getProjects(lang)).map((p) => ({
  slug: p.id,
  title: p.data.title,
  domain: p.data.domain,
  capolavoro: p.data.capolavoro,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={langNames[lang].locale.replace('-', '_')} />
    <meta property="og:locale:alternate" content={langNames[other].locale.replace('-', '_')} />
    <meta name="theme-color" content="#efe4cb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#18120c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url('favicon/favicon-32x32.png')} sizes="32x32" type="image/png" />
    <link rel="icon" href={url('favicon/favicon-16x16.png')} sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href={url('favicon/apple-touch-icon.png')} sizes="180x180" />
    <script is:inline>
      // Apply the saved theme before paint, and again after each client-side navigation.
      (() => {
        const apply = () => {
          try {
            const t = localStorage.getItem('theme');
            if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
          } catch {}
        };
        apply();
        if (!window.__themeHook) {
          window.__themeHook = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>

    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <filter id="ink-wobble" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="2" seed="7" />
        <feDisplacementMap in="SourceGraphic" scale="1.8" />
      </filter>
    </svg>

    <Header lang={lang} altHref={url(rest, other)} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <div class="toasts" id="toasts" role="status" aria-live="polite" transition:persist></div>
    <script id="codex-meta" type="application/json" set:html={JSON.stringify(meta)} />
    <script>
      import '../scripts/codex';
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    left: 16px;
    top: -60px;
    z-index: 200;
    padding: 10px 16px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 6px;
    text-decoration: none;
    transition: top 0.2s;
  }
  .skip:focus {
    top: 12px;
  }

  .toasts {
    position: fixed;
    left: 50%;
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 150;
    display: grid;
    gap: 10px;
    justify-items: center;
    translate: -50% 0;
    pointer-events: none;
    width: min(420px, calc(100% - 32px));
  }
</style>
