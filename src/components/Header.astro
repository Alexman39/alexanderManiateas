---
import { nav, site, url } from '../data/site';

const here = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const isActive = (href: string) => {
  const h = href.replace(/\/$/, '');
  return h === url('').replace(/\/$/, '') ? here === h : here === h || here.startsWith(`${h}/`);
};
---

<header class="site-header" transition:persist="site-header">
  <a class="brand" href={url('')} aria-label={`${site.name}, home`}>
    <svg class="monogram" viewBox="0 0 48 48" aria-hidden="true">
      <circle cx="24" cy="24" r="22" />
      <circle cx="24" cy="24" r="18.5" class="thin" />
      <text x="24" y="30.5" text-anchor="middle">AM</text>
    </svg>
    <span class="brand-name">
      <span>{site.name}</span>
      <span class="label">{site.role} · {site.city}</span>
    </span>
  </a>

  <nav class="nav" aria-label="Main">
    <ul id="nav-list">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} data-nav aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="tools">
    <a class="rank-chip" href={url('projects')} data-rank-chip title="Your rank in the workshop">
      <span class="rank-seal" aria-hidden="true"></span>
      <span data-rank-name>Garzone</span>
      <span class="rank-count" data-rank-count></span>
    </a>
    <button class="icon-button" type="button" data-theme-toggle aria-label="Toggle night study">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <g class="sun"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7" /></g>
        <g class="candle"><path d="M9 21h6M10 21V11h4v10M12 11V9" /><path d="M12 3.5c1.6 1.7 1.9 3 0 4.6-1.9-1.6-1.6-2.9 0-4.6Z" /></g>
      </svg>
    </button>
    <button class="icon-button menu-button" type="button" aria-expanded="false" aria-controls="nav-list" data-menu>
      <span class="visually-hidden">Menu</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
    </button>
  </div>
</header>

<script>
  import { progress } from '../scripts/codex';

  function syncHeader() {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header) return;
    const here = location.pathname.replace(/\.html$/, '').replace(/\/$/, '');
    const home = (import.meta.env.BASE_URL as string).replace(/\/$/, '');
    header.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((a) => {
      const h = new URL(a.href).pathname.replace(/\/$/, '');
      const active = h === home ? here === h : here === h || here.startsWith(`${h}/`);
      if (active) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
    const p = progress();
    header.querySelector('[data-rank-name]')!.textContent = p.rank.name;
    header.querySelector('[data-rank-count]')!.textContent = `${p.studied}/${p.total}`;
    header.classList.remove('menu-open');
    header.querySelector('[data-menu]')?.setAttribute('aria-expanded', 'false');
  }

  document.addEventListener('astro:page-load', syncHeader);
  document.addEventListener('codex:change', syncHeader);

  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (target.closest('[data-theme-toggle]')) {
      const root = document.documentElement;
      const dark =
        root.dataset.theme === 'dark' ||
        (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
      root.dataset.theme = dark ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', root.dataset.theme);
      } catch {}
    }
    const menu = target.closest('[data-menu]');
    if (menu) {
      const header = menu.closest('.site-header')!;
      const open = header.classList.toggle('menu-open');
      menu.setAttribute('aria-expanded', String(open));
    }
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 0 var(--gutter);
    background: color-mix(in srgb, var(--paper) 78%, transparent);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-right: auto;
    min-width: 0;
  }
  .monogram {
    width: 40px;
    height: 40px;
    flex: none;
    fill: none;
    stroke: var(--sanguine);
    stroke-width: 1.4;
    transition: transform 0.8s var(--ease);
  }
  .monogram .thin {
    stroke-width: 0.6;
    stroke-dasharray: 1.5 2.5;
  }
  .monogram text {
    fill: var(--ink);
    stroke: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
  }
  .brand:hover .monogram {
    transform: rotate(-12deg);
  }
  .brand-name {
    display: grid;
    line-height: 1.2;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    white-space: nowrap;
  }
  .brand-name .label {
    font-size: 0.62rem;
  }

  .nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    position: relative;
    display: block;
    padding: 8px 12px;
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-2);
  }
  .nav a:hover {
    color: var(--ink);
  }
  .nav a[aria-current='page'] {
    color: var(--ink);
  }
  /* Sanguine underline, drawn like a pen stroke. */
  .nav a::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 4px;
    height: 1.5px;
    background: var(--sanguine);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease);
  }
  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rank-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 7px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
  }
  .rank-seal {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--seal) 60%, #fff 20%), var(--seal) 60%);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--seal) 70%, #000 20%);
  }
  .rank-count {
    color: var(--ink-3);
  }

  .icon-button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .icon-button:hover {
    border-color: var(--ink-3);
    background: var(--sanguine-wash);
  }
  .icon-button svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon-button .candle {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-button .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-button .candle {
    display: inline;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-button .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .icon-button .candle {
      display: inline;
    }
  }

  .menu-button {
    display: none;
  }

  @media (max-width: 860px) {
    .brand-name .label {
      display: none;
    }
    .menu-button {
      display: grid;
    }
    .nav {
      position: fixed;
      inset: var(--header-h) 0 auto;
      padding: 8px var(--gutter) 24px;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s, transform 0.35s var(--ease), visibility 0.25s;
    }
    .menu-open .nav {
      opacity: 1;
      transform: none;
      visibility: visible;
    }
    .nav ul {
      flex-direction: column;
    }
    .nav a {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 600;
      padding: 8px 0;
    }
    .nav a::after {
      left: 0;
      right: auto;
      width: 40px;
    }
  }

  @media (max-width: 520px) {
    .brand-name {
      display: none;
    }
    .rank-count {
      display: none;
    }
  }
</style>
