---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PortraitStudy from '../components/PortraitStudy.astro';
import Sketch from '../components/Sketch.astro';
import { seals, statuses } from '../data/codex';
import { site, url } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.folio - b.data.folio);
const bench = ['flexpro', 'college-compass', 'ocr-invoice-reader']
  .map((slug) => projects.find((p) => p.id === slug))
  .filter((p) => p !== undefined);
const finished = projects.filter((p) => p.data.status !== 'non-finito').length;

const articles = (await getCollection('articles')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base>
  <div class="page home">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-text">
        <p class="label">{site.role} · {site.city} · est. MMXX</p>
        <h1 class="display">
          Alexander<br /><span class="surname">Maniateas</span>
        </h1>
        <p class="lead">
          I build web apps and small, sharp tools for people and businesses. I'm studying Computer Science at
          Metropolitan College, I've freelanced since 2020, and when I'm not at the keyboard, I'm training.
        </p>
        <div class="hero-actions">
          <a class="button primary" href={url('projects')}>Open the codex →</a>
          <a class="button" href={url('about')}>About me</a>
        </div>
        <p class="hero-note">
          <button class="mirror" type="button">Studia prima la scienza, e poi seguita la pratica.</button>
          <span class="label">First study the science, then follow the practice · Leonardo</span>
        </p>
      </div>
      <div class="hero-art">
        <PortraitStudy />
      </div>
    </section>

    <!-- On the workbench -->
    <section class="bench" aria-labelledby="bench-title">
      <header class="section-head">
        <h2 id="bench-title">On the workbench</h2>
        <p class="label">What I'm building now</p>
      </header>
      <ul class="bench-list">
        {
          bench.map((p) => (
            <li>
              <a class="bench-card" href={url(`projects/${p.id}`)}>
                <div class="bench-art" transition:name={`sketch-${p.id}`}>
                  <Sketch name={p.data.sketch} state={p.data.status === 'non-finito' ? 'unfinished' : 'ink'} />
                </div>
                <div>
                  <span class="label">
                    {statuses[p.data.status]}
                    {p.data.capolavoro && <> · capolavoro</>}
                  </span>
                  <h3>{p.data.title}</h3>
                  <p class="italian">{p.data.motto}</p>
                  <p class="bench-summary">{p.data.summary}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- The codex, as an invitation -->
    <section class="invite">
      <div class="invite-strip" aria-hidden="true">
        {
          [...projects, ...projects].map((p) => (
            <Sketch name={p.data.sketch} state={p.data.status === 'non-finito' ? 'unfinished' : 'pencil'} class="strip-sketch" />
          ))
        }
      </div>
      <div class="invite-text">
        <p class="label">Il Codice</p>
        <h2>Every project is a folio. Study them all and become <em>Maestro</em>.</h2>
        <p>
          My portfolio is a notebook you explore: drag across the desk, open each drawing, earn the workshop's seals.{' '}
          {finished} works finished, {projects.length - finished} still on the bench, {seals.length} seals to earn.
        </p>
        <a class="button primary" href={url('projects')}>Enter the codex →</a>
      </div>
    </section>

    <!-- Writing -->
    <section class="writing" aria-labelledby="writing-title">
      <header class="section-head">
        <h2 id="writing-title">From the notebook</h2>
        <a class="label" href={url('articles')}>All articles →</a>
      </header>
      <ol class="entries">
        {
          articles.map((a) => (
            <li>
              <a href={url(`articles/${a.id}`)}>
                <time class="label" datetime={a.data.date.toISOString()}>
                  {fmt.format(a.data.date)}
                </time>
                <h3>{a.data.title}</h3>
                <p>{a.data.summary}</p>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    min-height: calc(100dvh - var(--header-h) - 120px);
  }
  .hero-text {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .hero h1 {
    font-weight: 600;
    line-height: 0.92;
  }
  .surname {
    font-style: italic;
    font-weight: 500;
    color: var(--sanguine);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-note {
    display: grid;
    gap: 4px;
    margin-top: 16px;
  }
  .hero-note .mirror {
    font-size: 1.35rem;
    justify-self: start;
  }
  .hero-art {
    max-width: 560px;
    width: 100%;
    justify-self: center;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }
  .section-head h2 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
  }
  .section-head a {
    text-decoration: none;
  }

  section + section {
    margin-top: clamp(80px, 11vw, 140px);
  }

  .bench-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .bench-card {
    display: grid;
    gap: 16px;
    height: 100%;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--card);
    text-decoration: none;
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), border-color 0.3s;
  }
  .bench-card:hover {
    color: inherit;
    transform: translateY(-4px) rotate(-0.4deg);
    box-shadow: var(--shadow);
    border-color: var(--paper-edge);
  }
  .bench-art {
    width: 55%;
    aspect-ratio: 1;
    justify-self: center;
  }
  .bench-art :global(.sketch) {
    width: 100%;
    height: 100%;
  }
  .bench-card h3 {
    font-size: 1.9rem;
    margin-top: 4px;
  }
  .bench-card .italian {
    font-size: 1.15rem;
  }
  .bench-summary {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  .invite {
    position: relative;
    display: grid;
    gap: 40px;
    padding: clamp(32px, 6vw, 72px);
    border: 1px solid var(--paper-edge);
    border-radius: 24px;
    background: var(--paper-deep);
    box-shadow: inset 0 0 120px -40px var(--vignette);
    overflow: hidden;
  }
  .invite-strip {
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    display: flex;
    gap: 12px;
    width: max-content;
    animation: drift 60s linear infinite;
  }
  .invite-strip :global(.strip-sketch) {
    width: 120px;
    height: 120px;
    flex: none;
    transition: transform 0.6s var(--ease);
  }
  @keyframes drift {
    to {
      transform: translateX(calc(-50% - 6px));
    }
  }
  .invite-text {
    display: grid;
    gap: 16px;
    justify-items: start;
    max-width: 680px;
  }
  .invite-text h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
  }
  .invite-text h2 em {
    color: var(--sanguine);
    font-weight: 500;
  }
  .invite-text p:not(.label) {
    color: var(--ink-2);
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entries a {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 6px 32px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .entries time {
    grid-row: span 2;
    padding-top: 8px;
  }
  .entries h3 {
    font-size: 1.7rem;
    transition: color 0.2s;
  }
  .entries a:hover h3 {
    color: var(--sanguine);
  }
  .entries p {
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero-art {
      order: -1;
      max-width: 380px;
    }
    .bench-list {
      grid-template-columns: 1fr;
    }
    .bench-card {
      grid-template-columns: 120px 1fr;
      align-items: start;
    }
    .bench-art {
      width: 100%;
    }
    .entries a {
      grid-template-columns: 1fr;
    }
    .entries time {
      grid-row: auto;
    }
  }
</style>
